generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model VisitorCounter {
  id        Int      @id
  count     Int      @default(0)
  updatedAt DateTime @updatedAt
}

model Shoutout {
  id        Int      @id @default(autoincrement())
  message   String
  handle    String?
  approved  Boolean  @default(false)
  createdAt DateTime @default(now())
} 